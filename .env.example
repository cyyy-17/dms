# ============================================================================
# SASDMS Environment Variables Configuration (.env.example)
# ============================================================================

# Database: Supabase Postgres (Dual connection mode required by Prisma + PgBouncer)
# Runtime pooled transaction connection (port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migration & CLI unpooled session connection (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Email Service: Resend (Called strictly from background NotificationQueue worker)
RESEND_API_KEY="re_your_resend_api_key_here"
SYSTEM_SENDER_EMAIL="SAS Document System <notifications@yourinstitution.edu.ph>"

# Vercel Cron Security Secret (Header bearer token)
CRON_SECRET="your-high-entropy-cron-secret-token"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://dms.yourinstitution.edu.ph"
